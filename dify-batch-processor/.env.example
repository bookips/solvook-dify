# .env.example

# --- Common Settings ---
# Please fill in your actual GCP Project ID
GCP_PROJECT_ID="solvook-infra"

# Path to your GCP service account key file for accessing Google Sheets.
# The path should be relative to the `dify-batch-processor` directory.
GOOGLE_APPLICATION_CREDENTIALS="../.gcp/solvook-infra-2b84d4594582.json"

# --- Loader Settings ---
# The ID of the Google Sheet to read from.
SPREADSHEET_ID="1R8uj87uCbJA5YxZSFWlEvJKjgIWZQCNh-EldR33fYLY"
# The name of the sheet (tab) to read from.
SHEET_NAME="data"
# The column index (0-based) or "ROW_NUMBER" to use as a unique ID.
UNIQUE_ID_COLUMN="id"
# The GCP region for Cloud Tasks. This is required even for local testing as the client library needs it.
LOCATION="asia-northeast3"
# The name of the Cloud Tasks queue.
QUEUE_NAME="dify-batch-processor-queue"
# The URL of the local worker service. No changes needed if running on the default port.
WORKER_URL="http://localhost:8082"

# --- Worker Settings ---
# The endpoint URL for your Dify workflow.
DIFY_API_ENDPOINT="http://dify-service-1030217702417.asia-northeast3.run.app/v1/workflows/run"
# Your Dify API key.
DIFY_API_KEY="app-G9PeAoqNxqas7dA0xzfgTzrR"
# Timeout in minutes for the Dify API call.
DIFY_API_TIMEOUT_MINUTES="10"

HIGH_PASSAGE_ANALYSIS_WORKFLOW_ID="0a179409-d6ee-46e2-bf78-83fd7d415123"
HIGH_PASSAGE_WORKBOOK_WORKFLOW_ID="9aa5df68-9912-4a74-8379-04eee2db8994"

MIDDLE_PASSAGE_ANALYSIS_WORKFLOW_ID="3622972e-71cf-45c0-97e0-029299cd13a3"
MIDDLE_PASSAGE_WORKBOOK_WORKFLOW_ID="63d7bdc0-1656-4c79-a19b-1ed2251c67ee"

AWS_S3_BUCKET="solvook-creator"

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=dify
